{
  "name": "genpark-ad-copy-generator-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Generate A/B tested ad copy variants for Google Search, Google Shopping, Meta (Facebook/Instagram), and TikTok ads with character limit compliance.",
  "author": "genpark",
  "category": "advertising",
  "tags": [
    "ads",
    "copy",
    "google",
    "meta",
    "tiktok",
    "a-b-testing"
  ],
  "inputs": {
    "product_name": {
      "type": "string",
      "description": "Product name."
    },
    "product_description": {
      "type": "string",
      "description": "Brief product description."
    },
    "key_benefits": {
      "type": "array",
      "description": "Top 3-5 product benefits."
    },
    "target_audience": {
      "type": "string",
      "description": "Target audience description."
    },
    "discount_offer": {
      "type": "string",
      "description": "Optional offer (e.g. '30% off', 'Free shipping')."
    },
    "platform": {
      "type": "string",
      "enum": [
        "google_search",
        "google_shopping",
        "meta",
        "tiktok",
        "all"
      ],
      "description": "Ad platform."
    }
  },
  "outputs": {
    "ads": {
      "type": "object",
      "description": "Platform-specific ad copy variants with character counts and scores."
    }
  },
  "entrypoint": "client.py",
  "example": "example_usage.py"
}